{
  "name": "mdforge-editor",
  "version": "0.2.0",
  "private": true,
  "description": "MDForge - a Windows Markdown editor with decoration-based live rendering",
  "main": "out/main/index.js",
  "author": "MDForge",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-app.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "jschardet": "^4.0.0"
  }
}
